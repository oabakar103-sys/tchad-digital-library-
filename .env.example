# ---------------------------------------------------------------------------
# Tchad Digital Library — variables d'environnement
# Copier vers .env.local puis remplir. Sans ces variables, le site fonctionne
# en MODE DEMO (données fictives lues depuis src/data/*.json, stockage local).
# ---------------------------------------------------------------------------

# ---- Supabase (PostgreSQL + Storage + Auth) ------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
# Clé de service : côté serveur uniquement (admin, uploads, CRUD). Ne pas exposer au client.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# ---- Application ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret de signature des cookies de session admin (générer : openssl rand -hex 32)
AUTH_SECRET=changez-moi-en-production-32-caracteres-minimum

# ---- Téléchargements (optionnel, limitation de débit) ---------------------
MAX_DOWNLOADS_PER_HOUR=20
RATE_LIMIT_CONTACT_PER_HOUR=5

# ---- Email (formulaire de contact, optionnel) ------------------------------
CONTACT_EMAIL=contact@tchaddigitallibrary.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
